# PostgreSQL connection string
# Local:    postgresql://postgres:YOUR_PASSWORD@localhost:5432/meridian_wealth
# Supabase: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/meridian_wealth"

# JWT secret — change this to a long random string in production
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

PORT=4000
